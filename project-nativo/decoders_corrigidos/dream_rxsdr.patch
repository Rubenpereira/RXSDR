diff --git a/src/sound/soundstdio.cpp b/src/sound/soundstdio.cpp
new file mode 100644
index 0000000..101efd1
--- /dev/null
+++ b/src/sound/soundstdio.cpp
@@ -0,0 +1,68 @@
+/******************************************************************************\
+ * RXSDR (PU1XTB) - entrada e saida pelo stdin/stdout. Veja soundstdio.h.
+ * GPL v2, como o resto do Dream.
+\******************************************************************************/
+#include "soundstdio.h"
+#include <cstdio>
+#include <cstdlib>
+#ifdef _WIN32
+# include <fcntl.h>
+# include <io.h>
+#endif
+
+static void modoBinario()
+{
+#ifdef _WIN32
+    static bool feito = false;
+    if (!feito) {
+        _setmode(_fileno(stdin), _O_BINARY);
+        _setmode(_fileno(stdout), _O_BINARY);
+        feito = true;
+    }
+#endif
+}
+
+CSoundInStdio::CSoundInStdio() { modoBinario(); }
+CSoundInStdio::~CSoundInStdio() {}
+
+bool CSoundInStdio::Init(int, int, bool) { return false; }
+
+bool CSoundInStdio::Read(CVector<short>& psData)
+{
+    const size_t n = size_t(psData.Size());
+    size_t lidos = 0;
+    while (lidos < n) {
+        const size_t r = fread(&psData[int(lidos)], sizeof(short), n - lidos, stdin);
+        if (r == 0) {
+            /* quem nos chamou fechou o cano: acabou */
+            fflush(stdout);
+            exit(0);
+        }
+        lidos += r;
+    }
+    return false;   /* false = sem erro */
+}
+
+void CSoundInStdio::Enumerate(std::vector<std::string>& names, std::vector<std::string>& desc, std::string& def)
+{
+    names.push_back("-"); desc.push_back("stdin"); def = "-";
+}
+
+CSoundOutStdio::CSoundOutStdio() { modoBinario(); }
+CSoundOutStdio::~CSoundOutStdio() {}
+
+bool CSoundOutStdio::Init(int, int, bool) { return false; }
+
+bool CSoundOutStdio::Write(CVector<short>& psData)
+{
+    const size_t n = size_t(psData.Size());
+    if (n == 0) return false;
+    if (fwrite(&psData[0], sizeof(short), n, stdout) != n) exit(0);
+    fflush(stdout);
+    return false;
+}
+
+void CSoundOutStdio::Enumerate(std::vector<std::string>& names, std::vector<std::string>& desc, std::string& def)
+{
+    names.push_back("-"); desc.push_back("stdout"); def = "-";
+}
diff --git a/src/sound/soundstdio.h b/src/sound/soundstdio.h
new file mode 100644
index 0000000..6ea9388
--- /dev/null
+++ b/src/sound/soundstdio.h
@@ -0,0 +1,47 @@
+/******************************************************************************\
+ * RXSDR (PU1XTB) - entrada e saida pelo stdin/stdout, para rodar o Dream como
+ * decodificador externo em qualquer sistema (inclusive Windows).
+ *
+ *  entrada : IQ 16 bits com sinal, intercalado (I,Q,I,Q...) no stdin
+ *  saida   : audio 16 bits estereo intercalado (E,D,E,D...) no stdout
+ *
+ * GPL v2, como o resto do Dream.
+\******************************************************************************/
+#ifndef SOUNDSTDIO_H
+#define SOUNDSTDIO_H
+
+#include "soundinterface.h"
+
+class CSoundInStdio : public CSoundInInterface
+{
+public:
+    CSoundInStdio();
+    virtual ~CSoundInStdio();
+    virtual bool Init(int iSampleRate, int iNewBufferSize, bool bNewBlocking);
+    virtual bool Read(CVector<short>& psData);
+    virtual void Enumerate(std::vector<std::string>& names, std::vector<std::string>& desc, std::string& def);
+    virtual std::string GetDev() { return sDev; }
+    virtual void SetDev(std::string sNewDev) { sDev = sNewDev; }
+    virtual void Close() {}
+    virtual std::string GetVersion() { return "stdin"; }
+private:
+    std::string sDev;
+};
+
+class CSoundOutStdio : public CSoundOutInterface
+{
+public:
+    CSoundOutStdio();
+    virtual ~CSoundOutStdio();
+    virtual bool Init(int iSampleRate, int iNewBufferSize, bool bNewBlocking);
+    virtual bool Write(CVector<short>& psData);
+    virtual void Enumerate(std::vector<std::string>& names, std::vector<std::string>& desc, std::string& def);
+    virtual std::string GetDev() { return sDev; }
+    virtual void SetDev(std::string sNewDev) { sDev = sNewDev; }
+    virtual void Close() {}
+    virtual std::string GetVersion() { return "stdout"; }
+private:
+    std::string sDev;
+};
+
+#endif
