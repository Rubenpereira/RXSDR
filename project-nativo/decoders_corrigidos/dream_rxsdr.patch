diff --git a/src/util/StatusBroadcast.cpp b/src/util/StatusBroadcast.cpp
index e5742fa..16dff00 100644
--- a/src/util/StatusBroadcast.cpp
+++ b/src/util/StatusBroadcast.cpp
@@ -65,6 +65,19 @@ CStatusBroadcast::~CStatusBroadcast()
 
 bool CStatusBroadcast::Start(CDRMReceiver* pReceiver, const std::string& strCustomPath)
 {
+    // RXSDR: "-" = uma linha JSON por atualizacao no stderr (funciona tambem
+    // no Windows, onde nao ha socket Unix). Linhas comecam com "STATUS ".
+    if (strCustomPath == "-")
+    {
+        if (bRunning || pReceiver == nullptr)
+            return false;
+        pDRMReceiver = pReceiver;
+        strSocketPath = "stderr";
+        bStderr = true;
+        bRunning = true;
+        broadcastThread = std::thread(&CStatusBroadcast::BroadcastLoop, this);
+        return true;
+    }
 #ifdef _WIN32
     // Windows: Unix Domain Sockets not supported
     // TODO: Implement Windows Named Pipes or TCP socket alternative
@@ -144,6 +157,14 @@ bool CStatusBroadcast::Start(CDRMReceiver* pReceiver, const std::string& strCust
 
 void CStatusBroadcast::Stop()
 {
+    if (bStderr)
+    {
+        bRunning = false;
+        if (broadcastThread.joinable())
+            broadcastThread.join();
+        bStderr = false;
+        return;
+    }
 #ifdef _WIN32
     // Windows: Nothing to stop (not implemented)
     return;
@@ -190,6 +211,17 @@ void CStatusBroadcast::Stop()
 
 void CStatusBroadcast::BroadcastLoop()
 {
+    if (bStderr)
+    {
+        while (bRunning)
+        {
+            std::string strJSON = CollectStatusJSON();
+            fprintf(stderr, "STATUS %s\n", strJSON.c_str());
+            fflush(stderr);
+            std::this_thread::sleep_for(std::chrono::milliseconds(UPDATE_INTERVAL_MS));
+        }
+        return;
+    }
 #ifdef _WIN32
     // Windows: Not implemented
     return;
